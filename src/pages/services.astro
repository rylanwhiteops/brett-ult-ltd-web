---
import Layout from '../layouts/Layout.astro';
import ScrollReveal from '../components/ScrollReveal.tsx';
import Marquee from '../components/Marquee.tsx';
import PageHeader from '../components/PageHeader.astro';
import Footer from '../components/Footer.astro';

const icons = {
  s1: `<svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="#D4AF37" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M14 3C10.5 8 9 11 9 14a5 5 0 0 0 10 0c0-3-1.5-6-5-11z"/>
    <path d="M14 10c-1.5 2.5-2 4-2 5a2 2 0 0 0 4 0c0-1-.5-2.5-2-5z" fill="#D4AF37" fill-opacity="0.2"/>
    <path d="M6 20h16M9 24h10"/>
  </svg>`,
  s2: `<svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="#D4AF37" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="14" cy="14" r="2"/>
    <line x1="14" y1="4" x2="14" y2="8"/>
    <line x1="14" y1="20" x2="14" y2="24"/>
    <line x1="4" y1="14" x2="8" y2="14"/>
    <line x1="20" y1="14" x2="24" y2="14"/>
    <line x1="7" y1="7" x2="10" y2="10"/>
    <line x1="18" y1="18" x2="21" y2="21"/>
    <line x1="21" y1="7" x2="18" y2="10"/>
    <line x1="10" y1="18" x2="7" y2="21"/>
  </svg>`,
  s3: `<svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="#D4AF37" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M14 3L4 7v8c0 6 4.5 11 10 13 5.5-2 10-7 10-13V7L14 3z"/>
    <path d="M14 9c-2 3-3 5-3 7a3 3 0 0 0 6 0c0-2-1-4-3-7z" fill="#D4AF37" fill-opacity="0.2"/>
  </svg>`,
  s4: `<svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="#D4AF37" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <rect x="5" y="6" width="18" height="19" rx="1"/>
    <line x1="9" y1="3" x2="9" y2="9"/>
    <line x1="19" y1="3" x2="19" y2="9"/>
    <line x1="5" y1="13" x2="23" y2="13"/>
    <polyline points="10,18 13,21 18,16"/>
  </svg>`,
  s5: `<svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="#D4AF37" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="14" cy="14" r="10"/>
    <polyline points="14,8 14,14 18,17"/>
  </svg>`,
};

const services = [
  {
    id: 's1',
    number: '01',
    title: 'Fire Suppression Systems',
    description: 'Red Seal Licensed Technicians. Fully insured, you can depend on us to service or install your fire sprinkler and/or standpipe systems in compliance with OBC and NFPA 13 code regulations. Our goal is to make sure you and your building are protected in the event of a fire.',
    bullets: [
      'NFPA 13 wet and dry pipe systems for residential, commercial, and industrial occupancies',
      'Pre-action and double-interlock systems for cold storage and data centres',
      'Deluge systems for high-hazard process areas and aircraft hangars',
      'Hydraulic calculations and drawings coordinated with our engineering partners',
      'Authority Having Jurisdiction (AHJ) submission and approval',
    ],
    standard: 'NFPA 13',
  },
  {
    id: 's2',
    number: '02',
    title: 'Sprinkler Design',
    description: 'We work hand in hand with trusted fire engineering partners to deliver design-build sprinkler systems for any application or building type. From warehouses and manufacturing floors to high-piled storage and residential builds.',
    bullets: [
      'Design-build coordination with engineering partners',
      'In-rack and ESFR sprinkler design for high-piled rack storage',
      'Occupancy classification and hazard analysis',
      'Coordination with structural, mechanical and electrical trades',
      'As-built drawings and record documents post-installation',
    ],
    standard: 'Design-Build',
  },
  {
    id: 's3',
    number: '03',
    title: 'NAICO Fire Protection',
    description: 'Acquired in 2021. NAICO\'s operations have been integrated into Ultimate Fire Protection, expanding our crew capacity, equipment fleet, and service coverage across the Niagara region.',
    bullets: [
      'Expanded crew capacity for large-scale commercial and industrial projects',
      'Additional equipment fleet: pumps, pipe equipment, specialty tools',
      'Broader service coverage across the Niagara region',
      'Continuity of service for all existing NAICO clients',
      'Same NFPA standards and direct-owner accountability',
    ],
    standard: 'Acquired 2021',
    acquired: true,
  },
  {
    id: 's4',
    number: '04',
    title: 'Annual Inspections & Testing',
    description: 'Scheduled inspection programs for sprinkler systems, standpipe systems, electric and diesel fire pumps, dry systems, and pre-action systems. We also test backflow preventers. Keeps your systems code-compliant and your insurance valid.',
    bullets: [
      'Sprinkler system quarterly, semi-annual and annual inspections (NFPA 25)',
      'Standpipe system testing and certification',
      'Electric and diesel fire pump flow testing and service',
      'Dry system and pre-action system inspections',
      'Backflow preventer testing',
      'Inspection certificates and digital record-keeping',
    ],
    standard: 'NFPA 25',
  },
  {
    id: 's5',
    number: '05',
    title: 'Emergency Service & Repair',
    description: '24/7 emergency response for system impairments, freeze damage, mechanical failures and post-incident restoration.',
    bullets: [
      '24-hour emergency dispatch, live answer, no call centre',
      'Impairment permits and watch service coordination',
      'Freeze damage assessment and pipe repair',
      'Post-fire system restoration and recharge',
      'Insurance adjuster documentation support',
    ],
  },
];
---

<Layout
  title="Services | Ultimate Fire Protection"
  description="Full-service fire suppression, design, inspection and emergency systems for residential, commercial, and industrial properties across Ontario."
>

  <PageHeader
    eyebrow="What We Do"
    heading="Built for"
    headingGold="Hard Jobs."
    sub="All engineered to NFPA standards by trusted fire engineering partners. All installed by our Red Seal licensed fitters. Hand in hand from design to install."
    watermark="SERVICE"
    stat="05"
    statLabel="Core Services"
  />

  <Marquee client:load />

  <!-- ── Service List / Accordion ── -->
  <section class="relative z-10 py-12 md:py-16 border-b border-[#D4AF37]/08">
    <div class="max-w-7xl mx-auto px-8 md:px-16">
      <ScrollReveal client:visible>
        <p class="eyebrow text-[#A08928] mb-8 md:mb-10">Select a Service for the Full Breakdown</p>
      </ScrollReveal>
      <div data-accordion-group>
        {services.map((s, i) => (
          <ScrollReveal client:visible delay={i * 0.05}>
            <div class="service-card group border-t border-[#D4AF37]/08 last:border-b" data-accordion-item>
              <button type="button" class="accordion-trigger w-full flex items-start md:items-center gap-3 md:gap-6 py-7 pl-2 pr-2 md:pl-6 md:pr-8 text-left" data-accordion-trigger aria-expanded="false">
                <div class="flex-shrink-0 w-10 h-10 flex items-center justify-center opacity-80 group-hover:opacity-100 transition-opacity">
                  <Fragment set:html={icons[s.id]} />
                </div>
                <span class="font-mono text-[#D4AF37]/30 text-sm font-bold flex-shrink-0 w-8">{s.number}</span>
                <div class="flex items-center gap-3 flex-1 flex-wrap">
                  <h3 class="font-display font-black text-xl md:text-2xl uppercase text-[#F5F0E8] group-hover:text-[#D4AF37] transition-colors duration-300 leading-tight">
                    {s.title}
                  </h3>
                  {s.acquired && (
                    <span class="text-[9px] font-bold tracking-[0.28em] text-[#D4AF37] border border-[#D4AF37]/40 px-2 py-0.5 uppercase">Acquired Co.</span>
                  )}
                </div>
                {s.standard && !s.acquired && (
                  <span class="hidden md:block eyebrow text-[#909090] flex-shrink-0">{s.standard}</span>
                )}
                <svg class="accordion-chevron flex-shrink-0 text-[#D4AF37]/40 group-hover:text-[#D4AF37] transition-colors duration-300" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="4,6 8,10 12,6"/>
                </svg>
              </button>
              <div class="accordion-panel" data-accordion-panel>
                <div class="pb-8 pl-2 pr-2 md:pl-[6.5rem] md:pr-8">
                  <p class="body-copy text-sm md:text-base mb-5 max-w-2xl">{s.description}</p>
                  <ul class="space-y-2.5">
                    {s.bullets.map((b) => (
                      <li class="body-copy text-sm flex gap-3">
                        <span class="text-[#D4AF37]/50 flex-shrink-0">&bull;</span>
                        <span>{b}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </ScrollReveal>
        ))}
      </div>
    </div>

    <script>
      import '../scripts/accordion.ts';
    </script>
  </section>

  <!-- ── M&A Callout ── -->
  <section class="relative z-10 border-t border-[#D4AF37]/08">
    <div class="max-w-7xl mx-auto px-8 md:px-16 py-14">
      <ScrollReveal client:visible>
        <div class="flex flex-col md:flex-row items-start md:items-center gap-6 md:gap-10">
          <div class="flex-1">
            <p class="eyebrow text-[#A08928] mb-3">Growth Through Acquisition</p>
            <h3 class="font-display font-black text-2xl md:text-3xl uppercase text-[#F5F0E8] leading-tight mb-3">
              Looking to Sell Your Fire Protection Company?
            </h3>
            <p class="body-copy text-sm max-w-xl">
              Ultimate Fire Protection is actively acquiring fire protection companies across Ontario. If you're a business owner looking to transition, talk directly to Brett about a straightforward, respectful process.
            </p>
          </div>
          <a href="mailto:brett@ultimatefire.ca"
            class="inline-flex items-center justify-center px-10 py-4 text-sm font-bold tracking-[0.18em] uppercase border border-[#D4AF37]/30 text-[#D4AF37] hover:border-[#D4AF37] hover:bg-[#D4AF37]/5 transition-all duration-300 whitespace-nowrap flex-shrink-0">
            brett@ultimatefire.ca
          </a>
        </div>
      </ScrollReveal>
    </div>
  </section>

  <!-- ── Why Brett ── -->
  <section class="relative z-10 border-t border-b border-[#D4AF37]/08 py-16 md:py-28">
    <div class="max-w-7xl mx-auto px-8 md:px-16 grid md:grid-cols-2 gap-10 md:gap-20 items-center">
      <ScrollReveal client:visible>
        <h2 class="font-display font-black text-5xl md:text-6xl xl:text-7xl uppercase leading-none">
          <span class="text-[#F5F0E8]">No Sales Team.</span><br />
          <span class="text-[#D4AF37]">Just the Crew.</span>
        </h2>
      </ScrollReveal>
      <ScrollReveal client:visible>
        <div class="space-y-8">
          {[
            { label: 'Direct Access', text: 'You talk to the person running the job. Not a dispatcher or account manager.' },
            { label: 'Ontario-Wide', text: 'Every AHJ in the province. Every inspector. Every quirk in the code.' },
            { label: 'Engineering Partners', text: 'Trusted fire engineering companies work hand in hand with us. Seamless coordination from design through install.' },
            { label: 'Full Documentation', text: 'As-builts, certificates, inspection records. Everything your insurer needs.' },
            { label: 'Local 853 Union', text: 'Unionized 853 member sprinkler company. Red Seal journeymen and registered apprentices on every job.' },
          ].map((item) => (
            <div class="flex gap-5 pb-8 border-b border-[#D4AF37]/08 last:border-0 last:pb-0">
              <div class="w-1 h-full min-h-[1rem] bg-[#D4AF37]/30 flex-shrink-0 mt-1" />
              <div>
                <p class="font-display font-bold text-lg uppercase text-[#F5F0E8] mb-1">{item.label}</p>
                <p class="body-copy text-sm">{item.text}</p>
              </div>
            </div>
          ))}
        </div>
      </ScrollReveal>
    </div>
  </section>

  <!-- ── CTA ── -->
  <section class="relative z-10 py-16 md:py-28">
    <div class="max-w-7xl mx-auto px-8 md:px-16 text-center">
      <ScrollReveal client:visible>
        <h2 class="font-display font-black text-6xl md:text-8xl uppercase leading-none tracking-[-0.02em] mb-8 md:mb-10">
          <span class="text-[#F5F0E8]">Tell Us About</span><br />
          <span class="text-[#D4AF37]">Your Job.</span>
        </h2>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/contact"
            class="inline-flex items-center justify-center px-12 py-5 text-sm font-bold tracking-[0.2em] uppercase bg-[#D4AF37] text-[#080808] hover:bg-[#f7e98e] transition-colors duration-300">
            Request Consultation
          </a>
          <a href="tel:+19056640061"
            class="inline-flex items-center justify-center px-12 py-5 text-sm font-bold tracking-[0.2em] uppercase border border-[#D4AF37]/30 text-[#D4AF37] hover:border-[#D4AF37] transition-colors duration-300">
            (905) 664-0061
          </a>
        </div>
      </ScrollReveal>
    </div>
  </section>

  <Footer />

</Layout>
